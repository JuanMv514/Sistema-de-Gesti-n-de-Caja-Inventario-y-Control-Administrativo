# Variables de configuración pública de Firebase Web App (Sección 4 y Sección 16)
# Copia este archivo como configuración local o agrega estas variables en Netlify:
# Site configuration -> Environment variables.
# IMPORTANTE: Nunca incluyas claves privadas de cuentas de servicio (Firebase Admin SDK) en el frontend.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Opcional para pruebas locales con Firebase Emulator Suite:
USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1
FIRESTORE_EMULATOR_PORT=8080
AUTH_EMULATOR_URL=http://127.0.0.1:9099
