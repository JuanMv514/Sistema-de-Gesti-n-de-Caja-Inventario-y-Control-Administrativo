rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function isAdmin() {
      return signedIn() && userRole() == 'Administrador';
    }

    match /usuarios/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /productos/{productoId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.precio >= 0
        && request.resource.data.stock >= 0;
      allow delete: if false; // No eliminar registros históricos
    }

    match /clientes/{clienteId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /cajas/{cajaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.montoInicial >= 0;
      // Una caja cerrada no puede volver a modificarse sin auditoría
      allow update: if signedIn() && resource.data.estado == 'Abierta';
      allow delete: if false;
    }

    match /ventas/{ventaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.total > 0
        && request.resource.data.items.size() > 0;
      // Solo se permite actualizar el estado para Anulada / Devuelta con auditoría, nunca borrar
      allow update: if isAdmin()
        && resource.data.estado == 'Completada'
        && request.resource.data.estado in ['Anulada', 'Devuelta'];
      allow delete: if false;
    }

    match /movimientos_inventario/{movId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /movimientos_contables/{movId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /devoluciones/{devId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /auditoria/{audId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
